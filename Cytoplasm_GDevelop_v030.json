        {
          "type": "BuiltinCommonInstructions::Comment",
          "content": "CYTOPLASM v0.3: landscape PC-first, throw with mouse and freeze anywhere with double-click. No ability menu."
        },
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "// CYTOPLASM v0.3: Native GDevelop JS scene — PC 16:9, no action menu.",
            "(function(){",
            "'use strict';",
            "if(typeof PIXI==='undefined'||typeof document==='undefined')return;",
            "let s=runtimeScene.__cytoplasmPC;",
            "if(!s){",
            "/* CYTOPLASM v0.3.0 — PC-first landscape gesture prototype.",
            "   A single material, interactions in the world. Canvas2D, zero dependencies.",
            "   World: 1280x720. Main mechanics: drag+throw, global double-click stasis,",
            "   single-click release, drag frozen object to anchor, active muscle tether,",
            "   momentum retention, reclaimable biomass. */",
            "function createCytoplasm(canvas) {",
            "'use strict';",
            "const W=1280, H=720, ctx=canvas.getContext('2d');",
            "const c={dark:'#0c111e',violet:'#bd91ee',pale:'#e6d6ff',mint:'#87f2d4',amber:'#ffd69a',red:'#ff8c9b'};",
            "const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));",
            "const dist=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y);",
            "const mix=(a,b,t)=>a+(b-a)*t;",
            "const now=()=>Date.now()/1000;",
            "let uid=0;",
            "const body=(type,x,y,w,h,mass=1)=>({id:++uid,type,x,y,w,h,mass,vx:0,vy:0,angle:0,omega:0,held:false,fixed:false,stored:null,cost:0,onGround:false,deleted:false,linked:false,connection:false});",
            "const S={room:1,phase:'play',t:0,elapsed:0,biomass:100,player:{x:120,y:604,vx:0,vy:0,w:30,h:46,grounded:false,riding:null},bodies:[],links:[],anchors:[],particles:[],platforms:[],door:null,drag:null,active:null,keys:{},lastClick:-100,clickRelease:null,mouse:{x:0,y:0},note:'',noteTimer:0,stats:{throws:0,freezes:0,releases:0,links:0,contractions:0,roomCompleted:0},tutorial:0,settled:false,won:false};",
            "const note=(s,time=2.7)=>{S.note=s;S.noteTimer=time};",
            "const throwHint='ПЕРЕТЯГНИ ПРЕДМЕТ МИШКОЮ  ·  ПОДВІЙНИЙ КЛІК БУДЬ-ДЕ — СТОП';",
            "function roomSetup(n){",
            " S.room=n;S.phase='play';S.biomass=100;S.links=[];S.bodies=[];S.particles=[];S.anchors=[];S.lastClick=-100;S.clickRelease=null;S.drag=null;S.active=null;S.settled=false;",
            " S.player={x:113,y:604,vx:0,vy:0,w:30,h:46,grounded:false,riding:null};",
            " if(n===1){",
            "  S.platforms=[{x:0,y:632,w:385,h:88},{x:510,y:662,w:126,h:58},{x:850,y:501,w:430,h:219}];",
            "  S.bodies=[body('chair',238,559,85,78,1.0),body('plank',317,583,138,25,.85),body('box',154,584,64,55,1.3)];",
            "  S.door={x:1184,y:437,w:66,h:64};",
            "  S.anchors=[];",
            "  note('ПЕРЕТЯГНИ СТІЛЕЦЬ, КИНЬ ЙОГО ТА ЗАФІКСУЙ ДВОМА КЛІКАМИ.',7);",
            " } else {",
            "  S.platforms=[{x:0,y:628,w:434,h:92},{x:713,y:609,w:120,h:111},{x:959,y:477,w:321,h:243}];",
            "  S.bodies=[body('cabinet',325,564,164,105,3.1),body('chair',213,556,84,78,1.0),body('plank',402,581,140,25,.85)];",
            "  S.anchors=[{id:'A',x:670,y:224},{id:'B',x:890,y:178},{id:'C',x:1010,y:304}];",
            "  S.door={x:1184,y:412,w:66,h:65};",
            "  note('КИНЬ ШАФУ, ЗАФІКСУЙ. ПРОТЯГНИ ВІД НЕЇ ДО СВІТЛОЇ ОПОРИ.',7);",
            " }",
            " S.player.y=S.platforms[0].y-S.player.h/2;",
            "}",
            "function getSurface(body,x){",
            " const dx=x-body.x, co=Math.cos(body.angle),si=Math.sin(body.angle);",
            " // Vertical slices through a rotated rectangle: top-most intersection, for walkable faces.",
            " const hw=body.w/2,hh=body.h/2, pts=[[-hw,-hh],[hw,-hh],[hw,hh],[-hw,hh]].map(p=>({x:body.x+p[0]*co-p[1]*si,y:body.y+p[0]*si+p[1]*co}));",
            " const ys=[];for(let i=0;i<4;i++){const a=pts[i],b=pts[(i+1)%4];if((x>=Math.min(a.x,b.x)-.1)&&(x<=Math.max(a.x,b.x)+.1)&&Math.abs(a.x-b.x)>.001)ys.push(a.y+(b.y-a.y)*(x-a.x)/(b.x-a.x));}",
            " if(ys.length<2)return null;",
            " // Extremely steep sides unsuitable for walking.",
            " if(Math.abs(si)>.65)return null;",
            " return Math.min(...ys);",
            "}",
            "function platformSurface(x){return S.platforms.filter(p=>x>=p.x&&x<=p.x+p.w).map(p=>p.y).sort((a,b)=>a-b)}",
            "function pickBody(x,y){",
            " let best=null,bestScore=Infinity;",
            " // Prefer real interior hits to padded hit areas, especially when furniture overlaps.",
            " for(let i=S.bodies.length-1;i>=0;i--){const b=S.bodies[i];if(b.deleted)continue;",
            "  const co=Math.cos(-b.angle),si=Math.sin(-b.angle),dx=x-b.x,dy=y-b.y;",
            "  const rx=dx*co-dy*si,ry=dx*si+dy*co;",
            "  const inside=Math.abs(rx)<=b.w/2&&Math.abs(ry)<=b.h/2;",
            "  if(Math.abs(rx)>b.w/2+10||Math.abs(ry)>b.h/2+10)continue;",
            "  const score=(inside?0:5)+.5*Math.hypot(rx/(b.w/2),ry/(b.h/2))-(b.fixed?.3:0);",
            "  if(score<bestScore){best=b;bestScore=score;}",
            " }",
            " return best;",
            "}",
            "function pickAnchor(x,y){return S.anchors.find(a=>dist(a,{x,y})<31)||null}",
            "function findLink(x,y){let best=null,bestDist=18;",
            " for(const l of S.links){let b=S.bodies.find(o=>o.id===l.bodyId);let a=S.anchors.find(o=>o.id===l.anchorId);if(!b||!a)continue;",
            "  const vx=a.x-b.x,vy=a.y-b.y,t=clamp(((x-b.x)*vx+(y-b.y)*vy)/(vx*vx+vy*vy||1),0,1);const d=Math.hypot(x-(b.x+vx*t),y-(b.y+vy*t));if(d<bestDist){best=l;bestDist=d;}",
            " }return best;",
            "}",
            "function freezeActive(){",
            " const b=S.active&&S.bodies.find(o=>o.id===S.active&&!o.deleted);",
            " if(!b){note('СПОЧАТКУ КИНЬ ПРЕДМЕТ. ПОТІМ ДВА КЛІКИ БУДЬ-ДЕ.');return false;}",
            " if(b.fixed){note('ЦЕЙ ПРЕДМЕТ ВЖЕ ЗАФІКСОВАНИЙ. КЛІКНИ ПО НЬОМУ ДЛЯ ЗВІЛЬНЕННЯ.');return false;}",
            " if(b.held){note('СПОЧАТКУ ВІДПУСТИ ПРЕДМЕТ.');return false;}",
            " const cost=Math.round(8+b.mass*5);",
            " if(S.biomass<cost+7){note('МАЛО БІОМАСИ. ВІДПУСТИ ІНШИЙ ПРЕДМЕТ.');return false;}",
            " b.stored={vx:b.vx,vy:b.vy,omega:b.omega};b.vx=0;b.vy=0;b.omega=0;b.fixed=true;b.cost=cost;",
            " S.biomass-=cost;S.stats.freezes++;note('ЗАФІКСОВАНО!  КЛІК ПО ПРЕДМЕТУ — ВІДПУСТИТИ.',2.2);return true;",
            "}",
            "function release(b){if(!b||!b.fixed)return false;",
            " b.fixed=false;b.vx=b.stored?.vx||0;b.vy=b.stored?.vy||0;b.omega=b.stored?.omega||0;b.stored=null;",
            " S.biomass=clamp(S.biomass+b.cost,0,100);b.cost=0;S.stats.releases++;S.links=S.links.filter(l=>l.bodyId!==b.id);note('ЦИТОПЛАЗМА ПОВЕРНУЛАСЯ ДО ТЕБЕ.',2);return true;",
            "}",
            "function attach(bodyTarget,anchor){",
            " if(!bodyTarget||!anchor)return false;",
            " if(S.links.some(l=>l.bodyId===bodyTarget.id&&l.anchorId===anchor.id)){note('ВЖЕ ЗʼЄДНАНО.');return false;}",
            " if(S.biomass<12){note('НЕ ВИСТАЧАЄ БІОМАСИ ДЛЯ ЖИВОЇ НИТКИ.');return false;}",
            " // Thaw a stasis body, retaining resources in the new living tether.",
            " if(bodyTarget.fixed){bodyTarget.fixed=false;bodyTarget.stored=null;S.biomass=Math.min(100,S.biomass+bodyTarget.cost);bodyTarget.cost=0;bodyTarget.vx=0;bodyTarget.vy=0;}",
            " S.biomass-=12;",
            " const length=dist(bodyTarget,anchor);",
            " S.links.push({bodyId:bodyTarget.id,anchorId:anchor.id,length,minLength:160,strength:1.0,auto:true,cost:12,tension:0});",
            " bodyTarget.linked=true;S.active=bodyTarget.id;S.stats.links++;note('ЖИВА НИТКА! ВОНА СКОРОЧУЄТЬСЯ Й ПІДІЙМАЄ ПРЕДМЕТ.',3);return true;",
            "}",
            "function doubleClick(x,y){S.clickRelease=null;S.lastClick=-100;return freezeActive()}",
            "function pointerDown(x,y,t=now()){",
            " if(S.phase==='won'){roomSetup(1);S.phase='play';return;}",
            " S.mouse={x,y};",
            " const b=pickBody(x,y);const link=findLink(x,y);",
            " if(b){S.active=b.id;S.drag={mode:b.fixed?'link':'body',b,start:{x,y,t},x,y,history:[{x,y,t}],moved:false};if(!b.fixed){b.held=true;b.vx=0;b.vy=0;b.omega=0}return;}",
            " if(link){S.drag={mode:'tether',link,start:{x,y,t},x,y,moved:false};return;}",
            " S.drag={mode:'empty',start:{x,y,t},x,y,moved:false};",
            "}",
            "function pointerMove(x,y,t=now()){",
            " S.mouse={x,y};const d=S.drag;if(!d)return;",
            " d.x=x;d.y=y;if(Math.hypot(x-d.start.x,y-d.start.y)>8)d.moved=true;",
            " if(d.mode==='body'){",
            "  // Drag gives direct response. A recent motion history controls the throw.",
            "  const b=d.b;b.x=clamp(x,26,W-26);b.y=clamp(y,80,H-34);b.angle=clamp((x-d.start.x)*.0025,-.65,.65);",
            "  d.history.push({x,y,t});while(d.history.length>2 && t-d.history[0].t>.11)d.history.shift();",
            " }",
            "}",
            "function pointerUp(x,y,t=now()){",
            " const d=S.drag;S.drag=null;S.mouse={x,y};",
            " if(!d){if(t-S.lastClick<.34)doubleClick(x,y);else S.lastClick=t;return;}",
            " if(d.mode==='body'){",
            "  const b=d.b;b.held=false;",
            "  if(d.moved){const from=d.history[0]||d.start;const duration=Math.max(.025,t-from.t),dx=x-from.x,dy=y-from.y;",
            "   b.vx=clamp(dx/duration*.68,-900,900);b.vy=clamp(dy/duration*.68,-850,850);",
            "   if(Math.abs(b.vx)+Math.abs(b.vy)<90){b.vx=(x-d.start.x)*.30;b.vy=Math.min(0,(y-d.start.y)*.30)}",
            "   b.omega=clamp(b.vx*.0014,-1.7,1.7);S.stats.throws++;S.active=b.id;S.lastClick=-100;S.clickRelease=null;",
            "   note('ПРЕДМЕТ У РУСІ. ПОДВІЙНИЙ КЛІК БУДЬ-ДЕ — ЗАФІКСУВАТИ.',2.5);return;",
            "  }",
            "  S.active=b.id;",
            " }",
            " if(d.mode==='link'&&d.moved){",
            "  const anchor=pickAnchor(x,y);if(anchor){attach(d.b,anchor);S.lastClick=-100;return;}",
            "  const dest=pickBody(x,y);if(dest&&dest.id!==d.b.id){note('У ЦІЙ ВЕРСІЇ НИТКИ ЗʼЄДНУЮТЬ ПРЕДМЕТИ З ОПОРАМИ.');}",
            "  else note('ПРОТЯГНИ ВІД ЗАФІКСОВАНОГО ПРЕДМЕТА ДО ЗЕЛЕНОГО КІЛЬЦЯ.');",
            "  S.lastClick=-100;return;",
            " }",
            " if(d.mode==='tether'&&d.moved){",
            "  const l=d.link;l.auto=false;l.length=clamp(l.length+(y-d.start.y)*.6+(x-d.start.x)*.4,l.minLength,720);S.stats.contractions++;",
            "  note('ПОТЯГНУВ ЗА НИТКУ — ЗМІНИВ ЇЇ ДОВЖИНУ.',1.7);S.lastClick=-100;return;",
            " }",
            " if(d.mode==='link'&&!d.moved){S.clickRelease={id:d.b.id,deadline:t+.34};}",
            " if(t-S.lastClick<.34){S.clickRelease=null;S.lastClick=-100;freezeActive();return;}",
            " S.lastClick=t;",
            "}",
            "function keyDown(k){S.keys[k.toLowerCase()]=true;if([' ','space','arrowup','w'].includes(k.toLowerCase())&&S.player.grounded){S.player.vy=-620;S.player.grounded=false;S.player.riding=null}if(k.toLowerCase()==='r')roomSetup(S.room);}",
            "function keyUp(k){S.keys[k.toLowerCase()]=false}",
            "function resetKeys(){S.keys={};S.drag=null;for(const b of S.bodies)b.held=false;S.player.vx=0;}",
            "function updatePlayer(dt){",
            " const p=S.player,prevFeet=p.y+p.h/2;",
            " const dir=((S.keys.d||S.keys.arrowright)?1:0)-((S.keys.a||S.keys.arrowleft)?1:0);",
            " p.vx=dir*255; // no residual movement after release, intentionally instant",
            " p.x=clamp(p.x+p.vx*dt,p.w/2,W-p.w/2);",
            " p.vy+=1540*dt;p.y+=p.vy*dt;",
            " p.grounded=false;p.riding=null;",
            " const landings=[];",
            " for(const plat of S.platforms){if(p.x+p.w*.37>plat.x&&p.x-p.w*.37<plat.x+plat.w)landings.push({y:plat.y,id:'ground'});}",
            " for(const b of S.bodies){if(b.deleted||b.held)continue;const surface=getSurface(b,p.x);if(surface!==null)landings.push({y:surface,id:b.id});}",
            " const afterFeet=p.y+p.h/2;",
            " if(p.vy>=-5){for(const l of landings.sort((a,b)=>a.y-b.y)){",
            "  if(prevFeet<=l.y+12&&afterFeet>=l.y&&afterFeet<l.y+40){p.y=l.y-p.h/2;p.vy=0;p.grounded=true;p.riding=l.id==='ground'?null:l.id;break;}",
            " }}",
            " if(p.y>H+90){roomSetup(S.room);note('ПРОБУЙ ЩЕ РАЗ. СТВОРИ ПЛАТФОРМУ ІЗ ПРЕДМЕТА.');return;}",
            " if(p.x>S.door.x-20&&p.x<S.door.x+S.door.w+20&&Math.abs((p.y+p.h/2)-S.platforms[S.platforms.length-1].y)<90){",
            "  S.stats.roomCompleted++;",
            "  if(S.room===1){roomSetup(2);note('КІМНАТА 2. ПРИКРІПИ ЖИВУ НИТКУ ДО СТЕЛЬОВОЇ ОПОРИ.',6)}",
            "  else{S.phase='won';S.won=true;note('ЕКСПЕРИМЕНТ ПРОЙДЕНО!')}",
            " }",
            "}",
            "function updateBodies(dt){",
            " for(const b of S.bodies){if(b.deleted||b.fixed||b.held)continue;",
            "  const oldY=b.y, oldBottom=b.y+b.h/2;",
            "  b.vy+=1300*dt;b.x+=b.vx*dt;b.y+=b.vy*dt;b.angle+=b.omega*dt;",
            "  b.vx*=Math.pow(.985,dt*60);b.omega*=Math.pow(.989,dt*60);",
            "  if(b.x<b.w/2){b.x=b.w/2;b.vx=Math.abs(b.vx)*.5}if(b.x>W-b.w/2){b.x=W-b.w/2;b.vx=-Math.abs(b.vx)*.5}",
            "  for(const p of S.platforms){",
            "   if(b.x+b.w*.3>p.x&&b.x-b.w*.3<p.x+p.w&&b.vy>=0&&oldBottom<=p.y+18&&b.y+b.h/2>=p.y){",
